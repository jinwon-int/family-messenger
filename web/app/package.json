{
  "name": "@family-messenger/web-app",
  "version": "0.1.0",
  "private": true,
  "description": "패밀리챗 웹 앱 — matrix-js-sdk 기반 가족 대화 화면 (roadmap #92 stage 1, decision D)",
  "type": "module",
  "license": "SEE LICENSE IN ../../LICENSE",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--max-old-space-size=2048 node --test --test-concurrency=4 tests/*.test.js",
    "smoke:sdk": "node tests/transport_smoke.mjs",
    "build": "node build.mjs",
    "serve": "node serve.mjs",
    "dev": "node build.mjs && node serve.mjs",
    "test:dom": "NODE_OPTIONS=--max-old-space-size=2048 node --test --test-concurrency=4 tests/dom/*.test.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.15",
    "matrix-encrypt-attachment": "1.0.3",
    "matrix-js-sdk": "42.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "jsdom": "30.1.0"
  }
}
