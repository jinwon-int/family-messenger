# /etc/native-relay/cutover.env — 전환 스크립트 인자 모음(대기 호스트, root 0600). 값은 호스트에만.
# 비밀은 "파일 경로"만: DNS 편집 전용 토큰 파일(CF_DNS_TOKEN=…), Access 서비스 토큰 파일(CF_ACCESS_CLIENT_ID/SECRET=…).
# 사용: set -a; . /etc/native-relay/cutover.env; set +a; python3 /opt/family-messenger/scripts/native_relay_cutover.py $CUTOVER_ARGS [--confirm <token>]
CUTOVER_ARGS=--to soonwook --fence-record _native-relay-active.example.test \
  --peer-health http://100.64.0.1:18921/v2/health \
  --edge-health https://relay.example.test/v2/health --edge-token-file /etc/native-relay/edge-probe.env \
  --inbox /var/lib/native-relay-snapshots/inbox \
  --target-data-dir /var/lib/native-relay/data --target-policy-dir /var/lib/native-relay/policy \
  --target-static-dir /opt/native-relay/static --target-hande-dir /opt/native-relay/hande \
  --bump-seq 1000 --owner native-relay \
  --cf-zone-id <zone-id> --cf-dns-token-file /etc/native-relay/cf-dns-token.env \
  --hostname relay.example.test --hostname hande.example.test --tunnel-target <tunnel-id>.cfargotunnel.com \
  --peer-snapshot-cmd "ssh -o BatchMode=yes -o ConnectTimeout=10 seoseo systemctl start native-relay-snapshot.service" \
  --peer-stop-cmd "ssh -o BatchMode=yes -o ConnectTimeout=10 seoseo systemctl stop native-relay" \
  --client-hook "ssh -o BatchMode=yes gongmyoung sudo /usr/local/sbin/native-relay-repoint http://100.64.0.2:18921" \
  --state /var/lib/native-relay-snapshots/state
