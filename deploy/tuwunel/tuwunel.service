# Tuwunel systemd 유닛 — 가족 메신저 홈서버 (예시; /etc/systemd/system/tuwunel.service 로 복사 후 조정)
# 전용 사용자 `tuwunel`(홈 없음, 로그인 불가)을 미리 만든다:
#   useradd --system --home-dir /var/lib/tuwunel --shell /usr/sbin/nologin tuwunel
# 등록 토큰은 /etc/tuwunel/registration_token (root:tuwunel 0640)에 둔다 — 서비스 사용자가 직접 읽는다.
# 바이너리는 deploy/tuwunel/fetch-tuwunel.sh 로 받아 /opt/tuwunel/tuwunel 에 둔다(해시 검증 후).

[Unit]
Description=Tuwunel Matrix homeserver (family messenger)
Documentation=https://matrix-construct.github.io/tuwunel/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify-reload
User=tuwunel
Group=tuwunel
Environment=TUWUNEL_CONFIG=/etc/tuwunel/tuwunel.toml
ExecStart=/opt/tuwunel/tuwunel -c /etc/tuwunel/tuwunel.toml
# [2026-09-15 yukson 실측] 등록 토큰은 /etc/tuwunel/registration_token(root:tuwunel 0640)을 직접 읽는다.
# LoadCredential 경로는 서비스 정지 시 사라져 복원 드릴의 원샷(--maintenance)이 실패했다.
# 1.8 → 1.9 첫 기동은 리스너를 열기 전에 DB 마이그레이션을 수행한다. 강제 종료하면 손상될 수 있으므로
# 시작 제한을 넉넉히 두고, 업그레이드 전에는 반드시 백업한다(docs/TUWUNEL-DEPLOY.md).
TimeoutStartSec=600
TimeoutStopSec=60
Restart=on-failure
RestartSec=5
# RocksDB 파일 핸들
LimitNOFILE=65536

# --- 격리 -------------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# [2026-09-15 yukson 실측] Tuwunel 1.9.1(RocksDB·Tokio)은 io_uring 3종과 스레드/우선순위
# 호출(sched_setaffinity·nice·setpriority·sched_setattr·ioprio_set·getpriority)을 필수로
# 사용하며 @resources에 속해 있다. 이 재허용 줄이 없으면 SIGSYS로 기동 사망한다.
SystemCallFilter=io_uring_setup io_uring_enter io_uring_register sched_setaffinity nice setpriority sched_setattr ioprio_set getpriority
CapabilityBoundingSet=
AmbientCapabilities=
# DB와 미디어만 쓰기 허용. 설정은 읽기 전용.
StateDirectory=tuwunel
StateDirectoryMode=0700
# database_backup_path는 database_path 밖(백업 도구 요건)이므로 쓰기 허용에 별도 포함.
ReadWritePaths=/var/lib/tuwunel /var/lib/tuwunel-backups
UMask=0077

[Install]
WantedBy=multi-user.target
