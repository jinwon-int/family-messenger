# 매일 1회 가족방 대화 진행(1단계 게이트 신호)을 기록한다. 방 ID는 호스트별 값이라
# 환경 파일(/etc/family-messenger/gate.env: GATE_ROOM_ID=...)로 공급한다(코드에 박지 않음).
[Unit]
Description=Family messenger gate progress record (family room conversation counts)
After=network-online.target tuwunel.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/family-messenger/gate.env
ExecStart=/usr/bin/python3 /opt/family-messenger-tuwunel/scripts/gate_progress.py --config /etc/tuwunel/tuwunel.toml --admin-token-file /etc/family-messenger/tuwunel-admin-token --state /var/lib/family-messenger-gate
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
StateDirectory=family-messenger-gate
StateDirectoryMode=0700
