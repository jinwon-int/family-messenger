# /etc/family-messenger/relay-offhost-watchdog.env (0600 root) — family-messenger-relay-offhost-watchdog.service 의
# 호스트별 값(#897). 이 파일 자체에는 비밀값이 없다. 사설 주소·실제 도메인은 저장소에 쓰지 않는다(예시 값만).
# 펜스 레코드(릴레이 유닛 펜스와 같은 것). 값 = 활성 릴레이 호스트 이름.
RELAY_OFFHOST_FENCE_RECORD=_native-relay-active.example.com
# 활성 호스트 사설 주소 자리 {host}. 릴레이 포트는 양쪽 호스트가 같다.
RELAY_OFFHOST_DIRECT_TEMPLATE=http://{host}:18921
# 펜스에 쓰이는 호스트 이름 → 사설(tailnet) 주소. 릴레이를 돌릴 수 있는 호스트를 모두 적는다.
# 없는 이름을 펜스가 가리키면 설정 오류로 exit 1(상태는 그대로).
RELAY_OFFHOST_HOST_MAP=hosta=100.64.0.3,hostb=100.64.0.4
# 오너 앱이 쓰는 공개 릴레이 주소(Cloudflare 터널 + Access 뒤).
RELAY_OFFHOST_EDGE_URL=https://hande.example.com
# 알림에 표시할 이 노드(감시 노드)의 이름. 알림 줄은 「[이 노드 → 활성 호스트]」로 시작한다.
RELAY_OFFHOST_NODE=example-node
# 이 노드의 ccc push spool(같은 노드 Matrix 브리지가 소비하는 디렉터리).
RELAY_OFFHOST_SPOOL=/root/.claude/state/telegram-spool
# 스풀 레코드 event. 같은 노드 ccc-matrix-bridge 의 CCC_PUSH_FLEET_RELAY_DIRECT_EVENTS 에 이 이름을 넣어야
# 서서 플릿 알림 릴레이를 거치지 않는다(예: CCC_PUSH_FLEET_RELAY_DIRECT_EVENTS=SelfUpdate,relay-offhost-alert).
RELAY_OFFHOST_EVENT=relay-offhost-alert
# 추가 인자(선택). 기본값: --threshold 3, --realert-hours 6, --timeout 10.
RELAY_OFFHOST_EXTRA_ARGS=
