# 1분 주기. 3회 연속 확정이므로 다운 감지 지연은 ≤3분(#426 수용 기준). 홈서버 워치독 타이머와 같은 설정.
[Unit]
Description=Family messenger off-host native-relay watchdog (every minute)

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s
RandomizedDelaySec=10
Persistent=false
Unit=family-messenger-relay-watchdog.service

[Install]
WantedBy=timers.target
