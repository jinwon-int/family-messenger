# /etc/family-messenger/relay-watchdog.env (0600 root) — family-messenger-relay-watchdog.service 의 호스트별 값.
# 이 파일 자체에는 비밀값이 없다. 사설 주소·실제 도메인은 저장소에 쓰지 않는다(예시 값만).

# 릴레이의 사설망 주소(봇이 쓰는 것과 같은 경로). GET <URL>/v2/health 가 200 {"ok":true} 여야 up.
RELAY_WATCHDOG_DIRECT_URL=http://100.64.0.3:18921

# 오너 앱이 쓰는 공개 릴레이 주소(Cloudflare 터널 + Access 뒤).
RELAY_WATCHDOG_EDGE_URL=https://hande.example.com

# 알림에 표시할 이 노드(워치독이 도는 노드)의 이름.
RELAY_WATCHDOG_NODE=example-node

# 이 노드의 ccc push spool(브리지가 소비하는 디렉터리).
RELAY_WATCHDOG_SPOOL=/root/.claude/state/telegram-spool

# 추가 인자(선택). 기본값: --threshold 3, --realert-hours 6, --timeout 10.
# 엣지를 끝까지(터널 너머 릴레이 응답까지) 확인하려면 CF Access 서비스 토큰 파일(0600, 키
# CF_ACCESS_CLIENT_ID / CF_ACCESS_CLIENT_SECRET)을 따로 두고 경로만 넘긴다. 값은 여기 쓰지 않는다:
#   RELAY_WATCHDOG_EXTRA_ARGS=--access-env /etc/family-messenger/relay-watchdog-access.env
# 비워 두면 edge-only 모드: Access 응답(3xx/401/403)을 엣지 생존으로만 본다(Access 뒤 터널 단절은 못 잡음).
RELAY_WATCHDOG_EXTRA_ARGS=
