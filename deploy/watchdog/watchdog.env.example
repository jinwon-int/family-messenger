# /etc/family-messenger/watchdog.env (0600 root) — family-messenger-watchdog.service 의 호스트별 값.
# 비밀값은 없다. 사설 주소라도 저장소에는 쓰지 않는다(예시 값만).

# 홈서버 호스트의 사설망 주소(예: Tailscale IP 또는 MagicDNS 이름). TCP 연결만 시도하며 ssh 는 하지 않는다.
WATCHDOG_HOST=100.64.0.2

# 알림에 표시할 이 노드(워치독이 도는 노드)의 이름.
WATCHDOG_NODE=example-node

# 추가 인자(선택). 비워 두면 기본값: --homeserver-url 은 코드 기본값, --host-port 22, --threshold 3,
# --realert-hours 6, --timeout 10. 예: --homeserver-url https://matrix.example.com --host-port 22
WATCHDOG_EXTRA_ARGS=
