[Unit]
Description=Private encrypted Matrix CCC pilot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
UMask=0077
WorkingDirectory=/opt/family-messenger
ExecStart=/opt/family-messenger/.venv/bin/python /opt/family-messenger/scripts/fleet_matrix.py --config /etc/family-matrix-pilot/config.json
Restart=on-failure
RestartSec=35
RestartPreventExitStatus=78
TimeoutStopSec=40
KillMode=control-group
StandardOutput=null
StandardError=journal
LimitCORE=0

[Install]
WantedBy=multi-user.target
