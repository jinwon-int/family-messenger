# #354 A3 — 응답기 소켓(systemd socket activation). 봇(`native-relay-bot` 사용자)만 접속할 수 있다.
# 연결마다 `native-responder@.service` 가 fleet_worker.py 를 띄우고 stdin/stdout 을 이 소켓에 묶는다(Accept=yes).
# 설치: /etc/systemd/system/native-responder.socket → systemctl enable --now native-responder.socket (승인 항목)
[Unit]
Description=native-relay-bot agent responder socket (#354)

[Socket]
ListenStream=/run/native-responder/responder.sock
Accept=yes
SocketUser=native-relay-bot
SocketGroup=native-relay-bot
SocketMode=0600
DirectoryMode=0755
# 봇 재시작 중에는 옛 연결이 아직 닫히지 않아 새 연결과 잠시 겹친다(실측: 1 이면 "Too many incoming connections" 로 새 봇이 거부됨 → exit 1 → 10초 뒤 복구). 2 로 겹침을 허용한다.
MaxConnections=2

[Install]
WantedBy=sockets.target
