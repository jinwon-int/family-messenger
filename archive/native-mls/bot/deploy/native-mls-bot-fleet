#!/usr/bin/env bash
# native-mls-bot-fleet — 한데 봇 바이너리 플릿 순차 롤아웃 드라이버(정본). 노드마다 native-mls-bot-swap 을 보내 분리 실행하고
# 결과(RESULT=)를 기다린다. 2026-11-04 #676 · 11-09 #731+#733 롤아웃 드라이버(hande-bot676/733 fleet-driver.sh)의 일반화.
#
# 사용: native-mls-bot-fleet [--dry-run] <stage-dir> [<marker>]
#   <stage-dir>: SHA256SUMS 와 바이너리가 있는 디렉터리. SHA256SUMS 의 파일명에 `x86_64-gnu` / `aarch64-musl` 이 들어간
#                줄을 각각 x86 / arm 바이너리로 쓴다(둘 중 ORDER 에 필요한 것만 있으면 된다).
#   <marker>   : 새 바이너리 안의 고정 문자열(native-mls-bot-swap 세 번째 인수). 이전 바이너리에 없는 것을 고른다.
#   ORDER(env, 필수): 공백 구분 항목 `<ssh-target>[:<opt>...]`, 앞에서부터 하나씩. opt:
#     runit             Termux(runit) 노드 — aarch64 바이너리, setsid nohup 으로 분리 실행
#     extra=<u1+u2>     같은 바이너리 파일을 쓰는 다른 봇 유닛(BOT_EXTRA_UNITS), 예 extra=hande-bunjang-bot
#     bridge_user=<u>   브리지가 그 사용자의 systemd --user 유닛(BRIDGE_USER), 예 bridge_user=gongmyoung
#     bin=<path> unit=<name> idle=0   BOT_BIN · BOT_UNIT · IDLE_GATE 재정의(알림 전용 봇 등)
#   예) ORDER="nosuk dungae gwakga:extra=hande-bunjang-bot gongmyoung:bridge_user=gongmyoung daegyo:runit"
#   파일럿은 ORDER 에 노드 하나만 넣어 따로 돌리고, PASS 를 확인한 뒤 나머지를 돌린다.
# 규칙: PASS·UNCHANGED → 다음 노드. ABORT_BUSY(무변경) → 기록 후 끝에서 한 번 재시도. 그 밖(ROLLED_BACK, 전송 실패, 시간 초과 …)
#       → 그 자리에서 HALT, 남은 노드는 건드리지 않는다. 마지막 줄 `FLEET_EXIT=PASS|PARTIAL_BUSY|HALT`.
#   노드 로그: <remote $HOME>/.ccc-node/state/native-mls-bot-swap.log (RESULT 는 실행마다 새로 쓰는 run 로그에서 읽는다).
#   드라이버 로그는 표준 출력 — 세션과 분리해(systemd-run --collect …) 돌리고 실행마다 **새 로그 파일**로 받는다
#   (같은 파일에 이전 실행의 EXIT= 줄이 남으면 detached-job 대기가 바로 끝난 것으로 본다, 2026-11-09).
# 환경: FLEET_SSH(기본 ssh -o BatchMode=yes …) · FLEET_POLL(초, 20) · FLEET_POLL_MAX(번, 150 ≈ 50분: 유휴 게이트 30분 + 여유).
set -uo pipefail
DRY=0
[ "${1:-}" = --dry-run ] && { DRY=1; shift; }
[ $# -ge 1 ] && [ $# -le 2 ] || { echo "usage: $0 [--dry-run] <stage-dir> [<marker>]" >&2; exit 64; }
STAGE=$1; MARKER=${2:-}
ORDER=${ORDER:?set ORDER, e.g. ORDER=nosuk for a one-node pilot}
SSH=${FLEET_SSH:-ssh -o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=20}
POLL=${FLEET_POLL:-20}
POLL_MAX=${FLEET_POLL_MAX:-150}
HERE=$(cd "$(dirname "$0")" && pwd)
SWAP=$HERE/native-mls-bot-swap
[ -f "$STAGE/SHA256SUMS" ] || { echo "no $STAGE/SHA256SUMS" >&2; exit 66; }
pick() { awk -v k="$1" 'index($2,k){print $1, $2; exit}' "$STAGE/SHA256SUMS"; }
read -r X86_SHA X86_BIN <<<"$(pick x86_64-gnu)"
read -r ARM_SHA ARM_BIN <<<"$(pick aarch64-musl)"
for b in ${X86_BIN:+"$X86_BIN"} ${ARM_BIN:+"$ARM_BIN"}; do
  want=$(awk -v f="$b" '$2==f{print $1}' "$STAGE/SHA256SUMS")
  [ "$(sha256sum "$STAGE/$b" | cut -d' ' -f1)" = "$want" ] || { echo "local sha mismatch: $b" >&2; exit 65; }
done
q() { printf '%q' "$1"; }

# Parse one ORDER entry into globals: N MODE BIN SHA ENVS
parse() {
  local e=$1 opt
  IFS=: read -r -a parts <<<"$e"
  N=${parts[0]}; MODE=systemd; ENVS=""
  for opt in "${parts[@]:1}"; do
    case "$opt" in
      runit) MODE=runit ;;
      extra=*) ENVS="$ENVS BOT_EXTRA_UNITS=$(q "$(tr + ' ' <<<"${opt#extra=}")")" ;;
      bridge_user=*) ENVS="$ENVS BRIDGE_USER=$(q "${opt#bridge_user=}")" ;;
      bin=*) ENVS="$ENVS BOT_BIN=$(q "${opt#bin=}")" ;;
      unit=*) ENVS="$ENVS BOT_UNIT=$(q "${opt#unit=}")" ;;
      idle=0) ENVS="$ENVS IDLE_GATE=0" ;;
      *) echo "unknown ORDER option '$opt' in '$e'" >&2; return 64 ;;
    esac
  done
  ENVS="BOT_MODE=$MODE$ENVS"
  if [ "$MODE" = runit ]; then BIN=$ARM_BIN; SHA=$ARM_SHA; else BIN=$X86_BIN; SHA=$X86_SHA; fi
  [ -n "${BIN:-}" ] || { echo "no $([ "$MODE" = runit ] && echo aarch64-musl || echo x86_64-gnu) binary in SHA256SUMS for $N" >&2; return 66; }
}

deploy() {  # $1 = ORDER entry; prints "<node> RESULT=…", returns 0 pass · 3 busy · other = halt
  parse "$1" || return $?
  local rd run res cmd
  if [ "$DRY" = 1 ]; then echo "$N plan mode=$MODE bin=$BIN sha=${SHA:0:16} env=[$ENVS] marker=${MARKER:-none}"; return 0; fi
  rd=$($SSH "$N" 'mkdir -p "$HOME/.ccc-node/staging/native-mls-bot-swap" "$HOME/.ccc-node/state" && echo "$HOME/.ccc-node"') \
    || { echo "$N RESULT=DRIVER_SSH_FAIL"; return 20; }
  for f in "$STAGE/$BIN" "$SWAP"; do
    # tmp + mv: the driver host can be a target itself (#676: `cat >` onto the source truncated it).
    $SSH "$N" "cat > $rd/staging/native-mls-bot-swap/$(basename "$f").tmp && chmod 700 $rd/staging/native-mls-bot-swap/$(basename "$f").tmp && mv -f $rd/staging/native-mls-bot-swap/$(basename "$f").tmp $rd/staging/native-mls-bot-swap/$(basename "$f")" < "$f" \
      || { echo "$N RESULT=DRIVER_COPY_FAIL"; return 21; }
  done
  [ "$($SSH "$N" "sha256sum $rd/staging/native-mls-bot-swap/$BIN" | cut -d' ' -f1)" = "$SHA" ] || { echo "$N RESULT=DRIVER_REMOTE_SHA"; return 22; }
  run=$rd/state/native-mls-bot-swap.$(date -u +%Y%m%dT%H%M%SZ).log
  cmd="$ENVS bash $rd/staging/native-mls-bot-swap/native-mls-bot-swap $rd/staging/native-mls-bot-swap/$BIN $SHA $(q "$MARKER")"
  if [ "$MODE" = runit ]; then
    $SSH "$N" "setsid nohup env $cmd > $run 2>&1 < /dev/null &" || { echo "$N RESULT=DRIVER_LAUNCH_FAIL"; return 23; }
  else
    $SSH "$N" "systemd-run --unit=native-mls-bot-swap-\$(date -u +%Y%m%dT%H%M%SZ) --collect -p StandardOutput=file:$run -p StandardError=file:$run env $cmd" \
      || { echo "$N RESULT=DRIVER_LAUNCH_FAIL"; return 23; }
  fi
  echo "$N launched mode=$MODE env=[$ENVS] run=$run $(date -u +%FT%TZ)"
  res=""
  for _ in $(seq 1 "$POLL_MAX"); do
    sleep "$POLL"
    res=$($SSH "$N" "grep '^RESULT=' $run 2>/dev/null | tail -1")
    [ -n "$res" ] && break
  done
  $SSH "$N" "cat $run; cat $run >> $rd/state/native-mls-bot-swap.log" 2>/dev/null | sed "s/^/  $N | /"
  case "$res" in
    RESULT=PASS*|RESULT=UNCHANGED*) echo "$N ${res%% *}"; return 0 ;;
    RESULT=ABORT_BUSY*) echo "$N RESULT=ABORT_BUSY"; return 3 ;;
    "") echo "$N RESULT=DRIVER_TIMEOUT"; return 24 ;;
    *) echo "$N ${res%% *}"; return 5 ;;
  esac
}

echo "=== fleet start $(date -u +%FT%TZ) stage=$STAGE x86=${X86_SHA:0:16} arm=${ARM_SHA:0:16} marker=${MARKER:-none}$([ "$DRY" = 1 ] && echo ' (dry-run)')"
pass=""; busy=""
run_list() {  # $@ = entries; appends to pass/busy, exits on halt
  local e rc
  for e in "$@"; do
    deploy "$e"; rc=$?
    case $rc in
      0) pass="$pass ${e%%:*}" ;;
      3) busy="$busy $e" ;;
      *) echo "HALT at ${e%%:*} rc=$rc — remaining nodes untouched"; echo "SUMMARY pass=[$pass] busy=[$busy]"; echo "FLEET_EXIT=HALT"; exit 1 ;;
    esac
  done
}
# shellcheck disable=SC2086
run_list $ORDER
if [ -n "$busy" ]; then
  retry=$busy; busy=""
  echo "retry busy nodes:$retry"
  # shellcheck disable=SC2086
  run_list $retry
fi
echo "SUMMARY pass=[$pass] busy=[$busy] $(date -u +%FT%TZ)"
if [ -z "$busy" ]; then echo "FLEET_EXIT=PASS"; else echo "FLEET_EXIT=PARTIAL_BUSY"; fi
