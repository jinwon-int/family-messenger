<?xml version="1.0" encoding="utf-8"?>
<!-- 「한데」 Android (#338 B1). 백업 제외: 기기 키·상태는 OS 백업에 싣지 않는다(#338 §2 키 보호 · docs/DEVICE-KEY-CUSTODY.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".HandeApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hande">

        <!-- singleTask: 가족 로그인 콜백(hande://auth, #338 B2 · 릴레이 server/applogin.go appLoginCallback)이 기존 화면의 onNewIntent 로 돌아온다. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="hande" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- #366 C: 받은 첨부를 다른 앱으로 열기·공유 — cache/attachments/ 의 임시 파일만(복호화한 바이트는 이력에 저장하지 않는다, FILE-V2 §4-2). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
