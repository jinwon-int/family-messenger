      "expect": {
        "last": 123,
        "pending": [
          {
            "key": "web-a|r1",
            "seen": 60
          },
          {
            "key": "tab-e|r3",
            "seen": 7
          }
        ]
      }
    },
    {
      "name": "broken head: empty state",
      "text": "abc\nweb-a|r1|50",
      "expect": {
        "last": null,
        "pending": []
      }
    },
    {
      "name": "never ran, pending kept",
      "text": "\nweb-a|r1|50",
      "expect": {
        "last": null,
        "pending": [
          {
            "key": "web-a|r1",
            "seen": 50
          }
        ]
      }
    },
    {
      "name": "LF only: CRLF head is broken",
      "text": "5\r\nweb-a|r1|50",
      "expect": {
        "last": null,
        "pending": []
      }
    }
