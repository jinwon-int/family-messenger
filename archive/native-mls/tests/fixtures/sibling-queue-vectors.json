  "rescan_state_text_decode": [
    {
      "name": "absent",
      "text": null,
      "expect": {
        "last": null,
        "pending": []
      }
    },
    {
      "name": "empty",
      "text": "",
      "expect": {
        "last": null,
        "pending": []
      }
    },
    {
      "name": "empty head only",
      "text": "\n",
      "expect": {
        "last": null,
        "pending": []
      }
    },
    {
      "name": "head only",
      "text": "123",
      "expect": {
        "last": 123,
        "pending": []
      }
    },
    {
      "name": "bad lines dropped; repeated key keeps first position, later value",
